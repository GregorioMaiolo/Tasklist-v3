<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aufgabenliste</title>


    <!-- Normalize CSS (Voraussetzung für Skeleton) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css">
    <!-- Skeleton CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/skeleton/2.0.4/skeleton.min.css">

    <style>
        .done {
            text-decoration: line-through;
        }

        .assignment-form {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0;
        }

        .assignment-form select {
            width: auto;
            min-width: 180px;
            max-width: 220px;
            margin: 0;
        }

        .assignment-form button {
            margin: 0;
            white-space: nowrap;
        }

        .assignment-cell {
            min-width: 280px;
        }
    </style>
</head>

<body>
    <h1>Aufgabenliste v1</h1>

    <a href="/aufgaben/neu" class="button button-primary">
        Neue Aufgabe
    </a>
    <a href="/registrieren" class="button">
        Registrieren
    </a>
    <a href="/benutzer" class="button">
        Benutzer
    </a>
    <div class="container">
        <% if (tasks && tasks.length> 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titel</th>
                        <th>Beschreibung</th>
                        <th>Fälligkeitsdatum</th>
                        <th>Erstellt von</th>
                        <th>Zugewiesen an</th>
                        <th>Status</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    <% tasks.forEach(task=> { %>
                        <tr class="<%= task.done ? 'done' : '' %>">
                            <td>
                                <%= task.id %>
                            </td>
                            <td>
                                    <%= task.title %>
                                </td>
                            <td>
                                <%= task.description %>
                            </td>
                            <td>
                                <%= task.dueDate %>
                            </td>
                            <td>
                                <%= task.createdBy ? task.createdBy.email : 'Unbekannt' %>
                            </td>
                            <td class="assignment-cell">
                                <form class="assignment-form" action="/aufgaben/<%= task.id %>/zuweisen" method="POST">
                                    <select name="assignedToId" aria-label="Aufgabe zuweisen">
                                        <option value="" <%= !task.assignedTo ? 'selected' : '' %>>Nicht zugewiesen</option>
                                        <% users.forEach((user) => { %>
                                            <option
                                                value="<%= user.id %>"
                                                <%= task.assignedTo && task.assignedTo.id === user.id ? 'selected' : '' %>
                                            ><%= user.email %></option>
                                        <% }) %>
                                    </select>
                                    <button type="submit">Speichern</button>
                                </form>
                            </td>
                            <td>
                                <% if (task.done) { %>
                                    <span>Erledigt</span>
                                    <% } else { %>
                                        <span>Offen</span>
                                        <% } %>
                            </td>
                            <td>

                                <% if (!task.done) { %>
                                    <form action="/aufgaben/<%= task.id %>/erledigt" method="POST">
                                        <button type="submit">
                                            Erledigen
                                        </button>
                                    </form>
                                    <% } %>

                                        <form action="/aufgaben/<%= task.id %>/loeschen" method="POST">
                                            <button type="submit">
                                                Löschen
                                            </button>
                                        </form>

                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <p>Keine Aufgaben vorhanden.</p>
                <% } %>
    </div>
</body>

</html>